# AVIBench environment variables.
# Copy this file to `.env` and fill in the required values.
# `.env` is already in .gitignore — never commit real keys.

# OpenAI-compatible API gateway. Used by:
#   - models/gemini/run.py            (Gemini inference)
#   - auto_format/agent_format.py     (output refinement)
#   - eval/level_metrics/agent_eval_formatting.py  (eval-time formatting)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: model used by refine and eval-time formatting (default "gemini-2.5-flash").
# Any model id supported by the gateway works.
# REFINE_MODEL=gemini-2.5-flash

# Optional tunables
# GEMINI_MAX_RETRIES=5
# GEMINI_TIMEOUT=180
# REFINE_MAX_RETRIES=5
# REFINE_TIMEOUT=60
